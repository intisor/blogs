@* Replaces CleanBlog's _head.cshtml *@
@Html.Partial("_svg-symbols")
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
<meta name="description" content="@Document.GetString("Description", Document.GetString("SiteDescription", "Backend engineering from the trenches — C#, ASP.NET Core, and systems built for real problems."))" />
<meta name="author" content="Abdulawwal Intisor Mawupego" />

@* Open Graph *@
<meta property="og:type" content="@(Document.GetBool("IsPost", false) ? "article" : "website")" />
<meta property="og:title" content="@Document.GetTitle() — Intitech" />
<meta property="og:description" content="@Document.GetString("Description", "Backend engineering in C# and ASP.NET Core.")" />
<meta property="og:url" content="@Context.GetLink(Document, true)" />
<meta property="og:site_name" content="Intitech" />
@if (Document.ContainsKey("Image"))
{
    <meta property="og:image" content="@Document.GetString("Image")" />
}

@* Twitter *@
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@@intitech" />
<meta name="twitter:title" content="@Document.GetTitle()" />
<meta name="twitter:description" content="@Document.GetString("Description", "Backend engineering in C# and ASP.NET Core.")" />

@* Canonical *@
<link rel="canonical" href="@Context.GetLink(Document, true)" />

@* Tailwind & Plugins *@
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

@* Fonts & Icons *@
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400..900&family=IM+Fell+English:ital@0;1&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap" rel="stylesheet" />
