@* Intitech Layout - Updated with Tailwind & New Design System *@
<!DOCTYPE html>
<html class="dark" lang="en">
<head>
  @Html.Partial("_head")
  <style>
    /* ── SCROLLBAR ── */
    ::-webkit-scrollbar { width: 4px; }
    ::-webkit-scrollbar-track { background: #080705; /* void */ }
    ::-webkit-scrollbar-thumb { background: #2e2b22; /* sediment */ }
    ::-webkit-scrollbar-thumb:hover { background: #6b6355; /* ash */ }

    /* ── REVEAL ── */
    .reveal { opacity: 0; transform: translateY(16px); transition: opacity .6s ease, transform .6s ease; }
    .revealed { opacity: 1; transform: none; }

    /* ── MARKDOWN / ARTICLE STYLING ── */
    .prose-container {
        overflow-wrap: break-word;
        word-wrap: break-word;
        word-break: break-word;
    }
    .prose-container p { margin-bottom: 1.5rem; line-height: 1.75; }
    .prose-container h1, .prose-container h2, .prose-container h3, .prose-container h4 { font-family: 'Cinzel', serif; color: #e8dcc8; margin-top: 2.5rem; margin-bottom: 1rem; }
    .prose-container h1 { font-size: 2.5rem; font-weight: 700; }
    .prose-container h2 { font-size: 1.8rem; font-weight: 700; border-bottom: 1px solid #2e2b22; padding-bottom: 0.5rem; }
    .prose-container h3 { font-size: 1.4rem; font-weight: 700; }
    .prose-container a { color: #c8612a; text-decoration: none; border-bottom: 1px solid rgba(200,97,42,0.3); transition: border-color 0.3s, color 0.3s; }
    .prose-container a:hover { color: #ffb694; border-color: #c8612a; }
    .prose-container blockquote { border-left: 2px solid #a8873a; padding: 1rem 1.5rem; margin: 1.8rem 0; background: rgba(168,135,58,0.04); font-style: italic; color: #a58b81; }
    
    /* ── CODE BLOCKS ── */
    .prose-container pre { 
        background: #0f0d09; /* deep-earth */
        border: 1px solid #2e2b22; 
        padding: 2.5rem 1rem 1rem 1rem; 
        overflow-x: auto; 
        margin: 2rem 0; 
        font-family: 'JetBrains Mono', monospace; 
        color: #8ab87a; 
        font-size: 12px; 
        position: relative;
        border-radius: 4px;
        box-shadow: inset 0 0 20px rgba(0,0,0,0.4);
    }
    
    /* Code Block Language Label */
    .prose-container pre::before {
        content: attr(data-lang);
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1.8rem;
        background: #1c1a13; /* topsoil */
        border-bottom: 1px solid #2e2b22;
        color: #6b6355; /* ash */
        font-size: 9px;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        display: flex;
        align-items: center;
        padding: 0 1rem;
        font-weight: 600;
    }

    /* Custom Scrollbar for Code */
    .prose-container pre::-webkit-scrollbar { height: 4px; }
    .prose-container pre::-webkit-scrollbar-track { background: #0f0d09; }
    .prose-container pre::-webkit-scrollbar-thumb { background: #2e2b22; border-radius: 2px; }
    .prose-container pre::-webkit-scrollbar-thumb:hover { background: #c8612a; }

    @@media (min-width: 768px) { 
        .prose-container pre { padding: 3rem 1.5rem 1.5rem 1.5rem; font-size: 14px; } 
        .prose-container pre::before { height: 2.2rem; font-size: 10px; }
    }
    .prose-container code { font-family: 'JetBrains Mono', monospace; font-size: 0.85em; background: #2c2a26; padding: 0.15rem 0.4rem; border: 1px solid #373431; color: #e8c26e; border-radius: 0.25rem; }
    .prose-container pre code { background: none; border: none; padding: 0; color: inherit; font-size: inherit; border-radius: 0; }
    .prose-container img { max-width: 100%; height: auto; border: 1px solid #2e2b22; margin: 1.5rem 0; border-radius: 0.25rem; }
    .prose-container ul, .prose-container ol { padding-left: 1.5rem; margin-bottom: 1.5rem; list-style-type: disc; }
    .prose-container ol { list-style-type: decimal; }
    .prose-container li { margin-bottom: 0.5rem; }
    .prose-container hr { border: none; border-top: 1px solid #2e2b22; margin: 3rem 0; }

    /* ── RESPONSIVE LAYOUT ── */
    .main-container {
        width: 100%;
        max-width: 64rem; /* max-w-5xl */
        margin-left: auto;
        margin-right: auto;
        padding: 3rem 1.25rem; /* py-12 px-5 */
        box-sizing: border-box;
    }
    @@media (max-width: 340px) { .main-container { padding-left: 1rem; padding-right: 1rem; } }
    @@media (min-width: 640px) { .main-container { padding: 4rem 2.5rem; } }
    @@media (min-width: 768px) { .main-container { padding: 4rem 5rem; } }
    @@media (min-width: 1024px) { .main-container { padding: 4rem 8rem; } }
    @@media (min-width: 1280px) { .main-container { padding: 4rem 12rem; } }

    /* ── POST METADATA ── */
    .metadata-grid {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        color: #6b6355; /* ash */
    }
    @@media (min-width: 640px) {
        .metadata-grid {
            flex-direction: row;
            gap: 1rem;
            font-size: 12px;
        }
    }

    /* ── TABLE OF CONTENTS (ToC) ── */
    .toc-sidebar {
        position: fixed;
        left: 1.5rem;
        top: 50%;
        transform: translateY(-50%);
        width: 280px;
        z-index: 50;
        display: none;
    }
    @@media (min-width: 1200px) { .toc-sidebar { display: block; } }

    .toc-wrapper {
        position: relative;
        display: flex;
        align-items: flex-start;
    }

    #toc-vein-svg {
        width: 60px;
        height: 100%;
        min-height: 200px;
        overflow: visible;
        pointer-events: none;
    }

    .toc-list {
        list-style: none;
        padding: 0;
        margin: 0;
        position: relative;
        flex-grow: 1;
        padding-top: 10px;
        padding-bottom: 10px;
    }

    .toc-item {
        margin: 1.5rem 0;
        transition: all 0.4s ease;
        opacity: 0.2;
        position: relative;
        padding-left: 0.5rem;
    }
    
    .toc-item a {
        color: #6b6355; /* ash */
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        text-decoration: none;
        display: block;
        transition: all 0.3s;
        line-height: 1.4;
    }

    .toc-item.active {
        opacity: 1 !important;
        transform: translateX(8px);
    }
    .toc-item.active a {
        color: #ffb694; /* primary */
        text-shadow: 0 0 15px rgba(255, 182, 148, 0.4);
    }

    .toc-item.h3 {
        padding-left: 1.5rem;
        margin: 0.8rem 0;
    }
    .toc-item.h3 a { font-size: 10px; opacity: 0.8; }

    /* Branch paths */
    .vein-stem { stroke: #2e2b22; stroke-width: 1.5; fill: none; transition: stroke 0.5s; }
    .vein-branch { stroke: #2e2b22; stroke-width: 1; fill: none; transition: all 0.5s ease; stroke-dasharray: 100; stroke-dashoffset: 0; }
    .vein-branch.active { stroke: #c8612a; stroke-width: 2; filter: drop-shadow(0 0 3px #c8612a); stroke-dashoffset: 0; }
    .vein-node { fill: #2e2b22; transition: all 0.4s ease; }
    .vein-node.active { fill: #ffb694; r: 3; filter: drop-shadow(0 0 5px #ffb694); }
  </style>
  </style>
</head>
<body class="bg-void text-parchment font-body-main min-h-screen flex flex-col relative overflow-x-hidden">

  <!-- Left Side: Intelligent Vein + ToC -->
  <div class="hidden xl:block">
    <div class="fixed left-0 top-0 bottom-0 w-64 pointer-events-none z-0">
      <svg id="toc-vein-svg" class="h-full w-full stroke-sediment fill-none opacity-40" preserveAspectRatio="none" stroke-width="1" viewBox="0 0 100 1000">
        <path id="vein-stem" class="vein-stem" d=""></path>
        <g id="vein-branches"></g>
      </svg>
    </div>
    
    <aside class="toc-sidebar" id="toc-container">
      <nav>
        <ul class="toc-list ml-16" id="toc-list">
          <!-- Generated via JS -->
        </ul>
      </nav>
    </aside>
  </div>

  <!-- Right Side: Static Ornament (Original Shape) -->
  <div class="hidden xl:flex fixed right-0 top-0 bottom-0 w-32 pointer-events-none opacity-20 z-0 flex-col justify-between py-24 pr-8 scale-x-[-1]">
    <svg class="h-full w-full stroke-sediment fill-none" preserveAspectRatio="none" stroke-width="1" viewBox="0 0 100 400">
      <path d="M 50,0 Q 40,50 50,100 T 50,200 Q 60,250 50,300 T 50,400 M 50,50 Q 20,70 10,90 M 50,150 Q 80,170 90,190 M 50,250 Q 20,270 10,290 M 50,350 Q 80,370 90,390"></path>
    </svg>
  </div>

  <!-- Top Navigation -->
  @Html.Partial("_navbar")

  <!-- Main Content -->
  <main class="main-container flex-grow z-10 relative">
    @{
      bool isPost = Document.GetBool("IsPost") && !Document.GetBool("IsPostArchive");
    }
    @if (isPost)
    {
      @Html.Partial("_post-header")
      <article class="prose-container font-body-main text-body-main text-parchment space-y-6 mb-section-gap">
        @RenderBody()
        @Html.Partial("_share")
      </article>
    }
    else
    {
      @RenderBody()
    }
  </main>

  <!-- Footer -->
  @Html.Partial("_footer")

  <script>
    // Language detection and badge logic
    const detectLanguage = (code) => {
      const patterns = {
        'CSHARP': /\b(using\s+System|namespace|public\s+class|async\s+Task|\[HttpGet\])\b/,
        'SQL': /\b(SELECT|FROM|WHERE|INSERT\s+INTO|UPDATE|DELETE|JOIN|INNER\s+JOIN)\b/i,
        'JAVASCRIPT': /\b(const|let|var|function|=>|export\s+default|console\.log)\b/,
        'HTML': /<[a-z][\s\S]*>/i,
        'CSS': /\b([a-z-]+\s*:\s*[^;]+;)/,
        'JSON': /^[\s\n]*[\{\[]/,
        'BASH': /^\s*\$?\s*(sudo|apt|dotnet|git|ls|cd|mkdir)\b/
      };

      for (const [lang, pattern] of Object.entries(patterns)) {
        if (pattern.test(code)) return lang;
      }
      return 'CODE';
    };

    document.querySelectorAll('.prose-container pre code').forEach(code => {
      const pre = code.parentElement;
      const langClass = Array.from(code.classList).find(c => c.startsWith('language-'));
      
      let lang = 'CODE';
      if (langClass) {
        lang = langClass.replace('language-', '').toUpperCase();
      } else {
        // Run heuristic detection if language is not explicitly defined
        lang = detectLanguage(code.innerText);
      }
      
      // Map common aliases
      const aliases = { 'CS': 'CSHARP', 'JS': 'JAVASCRIPT', 'PY': 'PYTHON' };
      pre.setAttribute('data-lang', aliases[lang] || lang);
    });

    // Table of Contents Generator
    const tocList = document.getElementById('toc-list');
    const veinSvg = document.getElementById('toc-vein-svg');
    const veinStem = document.getElementById('vein-stem');
    const veinBranches = document.getElementById('vein-branches');
    const content = document.querySelector('.prose-container');
    
    if (tocList && content) {
      const headings = content.querySelectorAll('h2, h3');
      const observerOptions = {
        root: null,
        rootMargin: '-10% 0px -70% 0px',
        threshold: 0
      };

      const updateVein = () => {
        const items = document.querySelectorAll('.toc-item');
        if (items.length === 0) return;

        const screenH = window.innerHeight;
        
        let stemPath = `M 50,0`;
        for (let y = 100; y <= 1000; y += 200) {
            stemPath += ` Q 40,${y-50} 50,${y} T 50,${y+100}`;
        }
        veinStem.setAttribute('d', stemPath);
        
        veinBranches.innerHTML = '';
        items.forEach((item, index) => {
          const itemRect = item.getBoundingClientRect();
          const globalY = itemRect.top + (itemRect.height / 2);
          const isActive = item.classList.contains('active');
          const isH3 = item.classList.contains('h3');
          
          const svgY = (globalY / screenH) * 1000;
          
          // Determine attachment point with pseudo-random "organic" growth
          // Seeded by index to keep it stable but varied
          const seed = (index + 1) * 137;
          const yOffset = (seed % 60) - 30; // Random offset between -30 and +30
          const startY = svgY + yOffset;
          
          const phase = (startY % 200) / 200;
          const stemX = 50 + Math.sin(phase * Math.PI * 2) * 5;
          
          const targetX = isH3 ? 75 : 65;
          
          const branch = document.createElementNS("http://www.w3.org/2000/svg", "path");
          branch.setAttribute('class', `vein-branch ${isActive ? 'active' : ''}`);
          
          // Organic Cubic curve with varied orientation
          // We make it curve from the offset startY to the target svgY
          const cp1x = stemX + 20;
          const cp1y = startY + (yOffset * 0.2);
          const cp2x = targetX - 10;
          const cp2y = svgY - (yOffset * 0.1);
          
          const d = `M ${stemX},${startY} C ${cp1x},${cp1y} ${cp2x},${cp2y} ${targetX},${svgY}`;
          
          branch.setAttribute('d', d);
          veinBranches.appendChild(branch);
          
          const node = document.createElementNS("http://www.w3.org/2000/svg", "circle");
          node.setAttribute('class', `vein-node ${isActive ? 'active' : ''}`);
          node.setAttribute('cx', targetX);
          node.setAttribute('cy', svgY);
          node.setAttribute('r', isActive ? 3 : 1.5);
          veinBranches.appendChild(node);
        });
      };

      const tocObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            document.querySelectorAll('.toc-item').forEach(item => item.classList.remove('active'));
            const id = entry.target.getAttribute('id');
            const tocItem = document.querySelector(`.toc-item a[href="#${id}"]`)?.parentElement;
            if (tocItem) {
                tocItem.classList.add('active');
                updateVein();
            }
          }
        });
      }, observerOptions);

      headings.forEach(heading => {
        if (!heading.id) {
          heading.id = heading.innerText.toLowerCase().replace(/\s+/g, '-').replace(/[^\w-]/g, '');
        }

        const li = document.createElement('li');
        li.className = `toc-item ${heading.tagName.toLowerCase()}`;
        li.innerHTML = `<a href="#${heading.id}">${heading.innerText}</a>`;
        
        const a = li.querySelector('a');
        a.addEventListener('click', (e) => {
          e.preventDefault();
          const target = document.getElementById(heading.id);
          const offset = 100;
          const bodyRect = document.body.getBoundingClientRect().top;
          const elementRect = target.getBoundingClientRect().top;
          const elementPosition = elementRect - bodyRect;
          const offsetPosition = elementPosition - offset;

          window.scrollTo({
            top: offsetPosition,
            behavior: 'smooth'
          });
        });

        tocList.appendChild(li);
        tocObserver.observe(heading);
      });

      // Initial draw and update on resize
      setTimeout(updateVein, 100);
      window.addEventListener('resize', updateVein);
    }

    // make all external links open in new tab 
    document.querySelectorAll('.prose-container a[href^="http"]').forEach(link => {
      if (!link.href.includes(window.location.host)) {
        link.setAttribute('target', '_blank');
        link.setAttribute('rel', 'noopener noreferrer');
      }
    });

    // Scroll reveal logic for elements with the .reveal class
    const obs = new IntersectionObserver(entries => {
      entries.forEach((e, i) => {
        if (e.isIntersecting) {
          setTimeout(() => e.target.classList.add('revealed'), i * 80);
          obs.unobserve(e.target);
        }
      });
    }, { threshold: .08 });
    document.querySelectorAll('.reveal').forEach(el => obs.observe(el));

    // Mobile Menu Toggle Logic
    const menuToggle = document.getElementById('mobile-menu-toggle');
    const menuClose = document.getElementById('mobile-menu-close');
    const mobileMenu = document.getElementById('mobile-menu');

    if (menuToggle && mobileMenu) {
      menuToggle.addEventListener('click', () => {
        mobileMenu.classList.remove('translate-x-full');
      });
    }

    if (menuClose && mobileMenu) {
      menuClose.addEventListener('click', () => {
        mobileMenu.classList.add('translate-x-full');
      });
    }

    // Close mobile menu on resize to desktop
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 768 && mobileMenu && !mobileMenu.classList.contains('translate-x-full')) {
        mobileMenu.classList.add('translate-x-full');
      }
    });
  </script>

  @Html.Partial("_scripts")
</body>
</html>
