@* Intitech Navigation - Updated with Mobile Menu & Glass Header *@
<header class="fixed top-0 left-0 w-full z-[1000] bg-gradient-to-b from-void/90 via-void/60 to-transparent backdrop-blur-md border-b border-sprout/5 transition-all duration-300">
  <div class="container flex justify-between items-center w-full px-4 md:px-12 py-4 md:py-5 max-w-screen-2xl mx-auto">
    <a href="/" class="flex items-center space-x-3 md:space-x-4 transition-opacity hover:opacity-80 group">
      <svg class="w-8 h-8 md:w-10 md:h-10 transition-transform group-hover:scale-110" viewBox="0 0 120 120">
        <use href="#karakul-cap" />
      </svg>
      <div class="font-display-xl text-xl md:text-2xl font-bold tracking-[0.2em] uppercase">
        <span class="text-gold">INTITECH</span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center space-x-10">
      @foreach (IDocument doc in OutputPages.GetChildrenOf("index.html")
        .Where(x => x.GetBool("ShowInNavbar", true))
        .OrderBy(x => x.GetInt(Keys.Order)))
      {
        if (doc.Destination != "index.html")
        {
          bool isActive = Document.Destination == doc.Destination;
          string activeClass = isActive ? "text-ember" : "text-ash hover:text-ember";

          <a class="@activeClass font-mono-label text-[11px] tracking-[0.2em] uppercase transition-colors duration-300" href="@Context.GetLink(doc)">@doc.GetString("NavTitle", doc.GetTitle())</a>
        }
      }
      <a class="text-ash hover:text-ember font-mono-label text-[11px] tracking-[0.2em] uppercase transition-colors duration-300" href="https://intitech.dev" target="_blank">Portfolio ↗</a>
    </nav>

    <div class="flex items-center space-x-2 md:space-x-4">
      <a href="mailto:hello@intitech.dev" class="hidden lg:block font-mono-label text-[10px] tracking-widest text-ash hover:text-ember uppercase transition-colors">Direct Line</a>
      <span class="material-symbols-outlined text-ash hover:text-ember transition-colors cursor-pointer p-2 rounded hidden sm:block">terminal</span>
      
      <!-- Mobile Menu Toggle -->
      <button id="mobile-menu-toggle" class="md:hidden text-ash hover:text-ember p-2 transition-colors">
        <span class="material-symbols-outlined">menu</span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Navigation Overlay -->
<div id="mobile-menu" class="fixed inset-0 z-[1001] bg-void/98 backdrop-blur-xl translate-x-full transition-transform duration-500 ease-in-out md:hidden">
  <div class="flex flex-col h-full p-8">
    <div class="flex justify-between items-center mb-16">
      <svg class="w-10 h-10 text-gold" viewBox="0 0 120 120"><use href="#karakul-cap" /></svg>
      <button id="mobile-menu-close" class="text-ash hover:text-ember p-2">
        <span class="material-symbols-outlined text-3xl">close</span>
      </button>
    </div>
    
    <nav class="flex flex-col space-y-8">
      <a href="/" class="font-display-xl text-3xl text-script hover:text-ember transition-colors uppercase tracking-widest">Home</a>
      @foreach (IDocument doc in OutputPages.GetChildrenOf("index.html")
        .Where(x => x.GetBool("ShowInNavbar", true))
        .OrderBy(x => x.GetInt(Keys.Order)))
      {
        if (doc.Destination != "index.html")
        {
          <a class="font-display-xl text-3xl text-script hover:text-ember transition-colors uppercase tracking-widest" href="@Context.GetLink(doc)">@doc.GetString("NavTitle", doc.GetTitle())</a>
        }
      }
      <a class="font-display-xl text-3xl text-script hover:text-ember transition-colors uppercase tracking-widest border-t border-sediment pt-8" href="https://intitech.dev" target="_blank">Portfolio ↗</a>
    </nav>
    
    <div class="mt-auto pt-12 border-t border-sediment">
      <p class="font-mono-label text-[10px] text-ash uppercase tracking-widest mb-4">// Get in touch</p>
      <a href="mailto:hello@intitech.dev" class="font-body-italic text-xl text-ember">hello@intitech.dev</a>
    </div>
  </div>
</div>
<!-- Spacer to push content below fixed header -->
<div class="h-24"></div>

