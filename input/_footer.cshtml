@* Intitech Footer - Updated with Portfolio Branding *@
<footer class="bg-void border-t border-sediment py-16 mt-20 reveal">
  <div class="max-w-screen-xl mx-auto px-6">
    <div class="flex flex-col items-center mb-12">
      <div class="flex items-center justify-center mb-6">
        <svg class="w-12 h-12 text-gold mr-4" viewBox="0 0 120 120">
          <use href="#karakul-cap" />
        </svg>
        <span class="font-display-xl text-3xl text-gold tracking-widest uppercase">INTITECH</span>
      </div>
      <p class="font-mono-label text-[10px] text-sediment tracking-[0.3em] uppercase">
        Engineered to Endure // Build 2.4.0-Stable
      </p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-16">
      <a href="https://github.com/intisor" class="group flex flex-col p-6 bg-topsoil border border-sediment hover:border-ember transition-all duration-300" target="_blank">
        <span class="font-mono-label text-[9px] text-ash uppercase tracking-widest mb-1">Code Base</span>
        <span class="font-mono-label text-sm text-script group-hover:text-ember transition-colors italic">github.com/intisor</span>
      </a>
      <a href="https://x.com/intitechdev" class="group flex flex-col p-6 bg-topsoil border border-sediment hover:border-ember transition-all duration-300" target="_blank">
        <span class="font-mono-label text-[9px] text-ash uppercase tracking-widest mb-1">Transmission</span>
        <span class="font-mono-label text-sm text-script group-hover:text-ember transition-colors italic">x.com/intitechdev</span>
      </a>
      <a href="https://intitech.substack.com" class="group flex flex-col p-6 bg-topsoil border border-sediment hover:border-ember transition-all duration-300" target="_blank">
        <span class="font-mono-label text-[9px] text-ash uppercase tracking-widest mb-1">Subscription</span>
        <span class="font-mono-label text-sm text-script group-hover:text-ember transition-colors italic">Substack</span>
      </a>
      <a href="mailto:hello@intitech.dev" class="group flex flex-col p-6 bg-topsoil border border-sediment hover:border-ember transition-all duration-300">
        <span class="font-mono-label text-[9px] text-ash uppercase tracking-widest mb-1">Direct Line</span>
        <span class="font-mono-label text-sm text-script group-hover:text-ember transition-colors italic">Email Terminal</span>
      </a>
    </div>

    <div class="flex flex-col md:flex-row justify-between items-center gap-6 pt-8 border-t border-sediment/30">
      <div class="font-mono-label text-[10px] text-ash uppercase tracking-widest">
        © @DateTime.Now.Year Intitech Archives // Akure, Nigeria
      </div>
      <div class="font-mono-label text-[10px] text-ember uppercase tracking-[0.2em] flex items-center">
        System Status: Operational <span class="ml-3 w-1.5 h-1.5 bg-canopy rounded-full animate-pulse shadow-[0_0_8px_rgba(90,138,72,0.6)]"></span>
      </div>
    </div>
  </div>
</footer>

